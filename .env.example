# Copy this file to .env.local and fill in real values.
# Nothing here is a secret you should commit -- .env.local is gitignored.

# --- Supabase (your own project -- separate from Keyora's) --------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security -- never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayMongo (one-time full-access purchase via QR Ph) ------------------
# Price in whole pesos, e.g. 149 -- see lib/payments/products.ts. Optional;
# defaults to 149 if unset.
NEXT_PUBLIC_FULL_ACCESS_PRICE_PESOS=149
# Secret key: server-only, used to create Payment Intents.
PAYMONGO_SECRET_KEY=
# Public key: safe to expose to the browser -- used client-side to create
# Payment Methods and attach them, so raw card data never touches our server.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
# Shown once in the PayMongo dashboard when you register the webhook URL.
PAYMONGO_WEBHOOK_SECRET=

# --- Google AdSense --------------------------------------------------------
# Your publisher ID (ca-pub-...). Ads render as empty placeholders until
# this and the per-placement slot IDs below are set.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# One ad unit ID per placement -- create a unit per slot in the AdSense
# dashboard once approved.
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_PIANO=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_RECORDINGS_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_ACCOUNT_RAIL=

# --- PayPal (one-time full-access purchase, alternative to PayMongo) ----
# Price in whole/decimal dollars, e.g. 3 -- see lib/payments/products.ts.
NEXT_PUBLIC_FULL_ACCESS_PRICE_USD=3
# "sandbox" (default) or "live" -- selects api-m.sandbox.paypal.com vs api-m.paypal.com.
PAYPAL_ENV=sandbox
# Client ID: safe to expose to the browser -- used to load PayPal's JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Client Secret: server-only, used for the OAuth2 token + capture calls.
PAYPAL_CLIENT_SECRET=
